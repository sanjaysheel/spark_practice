8. Top 3 Customers by Revenue

PySpark:

from pyspark.sql.functions import sum, dense_rank
from pyspark.sql.window import Window

rev = df.groupBy("customer_id") \
        .agg(sum("amount").alias("revenue"))

w = Window.orderBy(rev.revenue.desc())

result = rev.withColumn(
    "rank",
    dense_rank().over(w)
).filter("rank<=3")

SQL:

WITH revenue AS (
SELECT customer_id,
       SUM(amount) revenue
FROM sales
GROUP BY customer_id
)
SELECT *
FROM (
SELECT *,
       DENSE_RANK() OVER
       (ORDER BY revenue DESC) rnk
FROM revenue
) t
WHERE rnk<=3;
